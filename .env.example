# Copy to .env. `supabase status` prints the local values.

# Optional: enables Claude for Kompass (otherwise demo mode) and the advisor AI.
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5

# Server access to the database (secret key, never sent to the browser).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_...
