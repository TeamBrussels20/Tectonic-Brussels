{
  "name": "kompass",
  "version": "0.2.0",
  "private": true,
  "description": "Kompass by KBC: a financial copilot for customers, and an AI-prepared workspace for the advisors who serve them.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.130.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-router": "^1.170.40",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.41",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.0.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
